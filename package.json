{
  "name": "heft",
  "version": "1.0.0",
  "private": true,
  "description": "Catch iOS app size regressions before they merge",
  "keywords": [
    "ios",
    "app-size",
    "xcarchive",
    "app-thinning",
    "github-action",
    "swift",
    "size-regression"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thatswiftguy/heft.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/main.ts -o dist --target es2022 --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "all": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/cache": "^4.0.3",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/picomatch": "^4.0.3",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
